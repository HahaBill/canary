    "seed-as-of": "node --experimental-strip-types scripts/seed-as-of-snapshots.ts"
  },
  "dependencies": {
    "@canary/shared": "*",
    "@canary/generator": "*",
    "@canary/engine": "*",
    "@canary/detectors": "*",
    "@canary/classification": "*",
    "@canary/pipeline": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0"
  }
}
