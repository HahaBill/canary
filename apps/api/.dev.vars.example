SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
OPENAI_API_KEY=
TAVILY_API_KEY=
WEBHOOK_SECRET=
FOUNDER_PHONE=
PUBLIC_BASE_URL=http://localhost:8787
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ALLOWED_PHONES=
# Private iCal URL for the founder's calendar (Google Calendar → Settings →
# "Secret address in iCal format"). Empty = no availability signal, alerts are
# never deferred.
CALENDAR_ICS_URL=
# 1 = show real event titles in /api/calendar. Anything else renders "Busy".
CALENDAR_SHOW_TITLES=
# Google OAuth web client (one account: the founder's). With both set, visit
# /oauth/google/start?secret=$WEBHOOK_SECRET once to connect; Google then replaces
# the iCal feed and Canary can book the incident review. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# IANA zone the 09:00-18:00 review slots are read in. Default America/New_York.
CALENDAR_TIMEZONE=
