SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
OPENAI_API_KEY=
# Chat model for conversational iMessage (non-keyword replies). Empty = gpt-4o-mini.
OPENAI_MODEL=
TAVILY_API_KEY=
WEBHOOK_SECRET=
FOUNDER_PHONE=
# Expected Google account for the founder calendar. A mismatch is flagged on
# the OAuth callback page, not rejected — the connected account is still used
# for free/busy. Empty = skip the check.
FOUNDER_EMAIL=bill.nguyentonhoang@gmail.com
PUBLIC_BASE_URL=http://localhost:8787
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Conversational web agent (Ask Canary). Same API key as TTS. Empty = /ask stays silent.
ELEVENLABS_AGENT_ID=
ALLOWED_PHONES=
# Private iCal URL for the founder's calendar (Google Calendar → Settings →
# "Secret address in iCal format"). Empty = no availability signal, alerts are
# never deferred.
CALENDAR_ICS_URL=
# 1 = show real event titles in /api/calendar. Anything else renders "Busy".
CALENDAR_SHOW_TITLES=
# Google OAuth web client (one account: the founder's). With both set, visit
# https://canary.bill-nguyentonhoang.workers.dev/oauth/google/start?secret=<WEBHOOK_SECRET>
# (locally http://localhost:8787/oauth/google/start?secret=<WEBHOOK_SECRET>)
# once to connect; Google then replaces the iCal feed and Canary can book the
# incident review. See README.md. Testing-mode refresh tokens expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# IANA zone the 09:00-18:00 review slots are read in. Default America/New_York.
CALENDAR_TIMEZONE=
# Demo clock: real minutes per simulated day. 0 freezes at the end of history; unset = 1.
DEMO_CLOCK_MINUTES_PER_DAY=
# Rho API token (rhobat_...). Empty = Rho's sandbox, which needs no credentials.
RHO_API_KEY=
